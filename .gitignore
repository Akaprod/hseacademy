# ============================================================================
# HSE Academy — .gitignore
# ============================================================================
# Canonical source for production BUILD_ID 0Bj5KDik3z4iw1SRaRBfv
# ============================================================================

# === Secrets (NEVER commit) ===
.env
.env.local
.env.production
.env.development
.env.test
.env.*.local

# === Build outputs (regénérables via `bun run build`) ===
.next/
out/
dist/
build/

# === Dependencies (regénérables via `bun install`) ===
node_modules/
.pnp.*
.yarn/

# === Bun cache ===
.bun/
bun.lock.db
bun.lock.bak

# === TypeScript build info ===
*.tsbuildinfo
tsconfig.tsbuildinfo

# === Logs ===
*.log
console.log
stderr.log
dev.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# === Database files (NEVER commit — contains user data) ===
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
custum.db
custum*.db
custom.db
custom*.db

# === Prisma ===
# Keep schema.prisma, but exclude generated client + migrations history
# (migrations are managed manually — see prisma/migrations README)
prisma/migrations/
prisma/generated/

# === Uploads / proofs (private user data) ===
uploads/
private_uploads/
public/uploads/
public/avatars/
public/payment-proofs/

# === OS / Editor ===
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*

# === Test coverage ===
coverage/
.nyc_output/

# === Backups (never commit) ===
backups/
*.bak
*.backup
*.tar.gz
*.zip

# === Temporaries ===
*.tmp
*.temp
.cache/
tmp/

# === Deploy artefacts ===
deploy/
packages/
