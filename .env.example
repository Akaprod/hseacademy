# ============================================================================
# HSE Academy — .env.example
# ============================================================================
# Copy this file to `.env` and fill in the real values.
# NEVER commit your real .env file.
# ============================================================================

# === Database (SQLite absolute path) ===
DATABASE_URL="file:/absolute/path/to/custum.db"

# === Auth (HMAC secret for session cookies — generate with `openssl rand -hex 32`) ===
# MUST be >= 32 chars. NEVER hardcode, NEVER commit, NEVER use the value shown here.
AUTH_SECRET="<generate-with-openssl-rand-hex-32>"

# === Root admin email (the user with role=admin that can manage all others) ===
ROOT_ADMIN_EMAIL="admin@institutqhse.com"

# === SMTP (for email verification + notifications) ===
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="mail@example.com"
SMTP_PASS="<your-smtp-password>"
SMTP_FROM="HSE Academy <mail@example.com>"

# === Public site URL (used for metadata + absolute URLs in emails) ===
NEXT_PUBLIC_SITE_URL="https://hseacademy.online"

# === Optional: Turbopack root override (CageFS fix — see next.config.ts) ===
# Used when deploying to Hostinger CageFS where lockfile parents confuse Turbopack.
# TURBOPACK_ROOT="/home/u398373271/domains/hseacademy.online/hbuilds/current/nodejs"

# === Optional: Proof upload directory (private — not web-accessible) ===
# PROOF_UPLOAD_DIR="/home/u398373271/private_uploads/payments"

# === Optional: Port override for local dev ===
# PORT=3000
